# Maintainer: Fossorial, Inc. <support@pangolin.net>
#
# Generated by .github/workflows/aur.yml from packaging/linux/aur/PKGBUILD.in;
# edit the template, not the AUR copy. It repackages the Arch package built
# for each release (make package-linux).

pkgname=pangolin-client-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Pangolin client: connects this computer to your Pangolin networks'
arch=('x86_64' 'aarch64')
url='https://pangolin.net'
license=('AGPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1')
provides=('pangolin-client')
conflicts=('pangolin-client')
backup=('etc/xdg/autostart/pangolin-client-autostart.desktop')
install=pangolin-client-bin.install
_release=https://github.com/fosrl/windows/releases/download/${pkgver}
source_x86_64=("${_release}/pangolin-client-amd64-${pkgver}.pkg.tar.zst")
source_aarch64=("${_release}/pangolin-client-arm64-${pkgver}.pkg.tar.zst")
noextract=("pangolin-client-amd64-${pkgver}.pkg.tar.zst" "pangolin-client-arm64-${pkgver}.pkg.tar.zst")
sha256sums_x86_64=('@SHA256_AMD64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local goarch=amd64
  [[ $CARCH == aarch64 ]] && goarch=arm64
  bsdtar -xf "${srcdir}/pangolin-client-${goarch}-${pkgver}.pkg.tar.zst" -C "${pkgdir}" \
    --exclude=.PKGINFO --exclude=.MTREE --exclude=.BUILDINFO --exclude=.INSTALL
  # The AUR helper updates this package, so the app shows its command
  # instead of installing updates itself.
  echo aur > "${pkgdir}/usr/share/pangolin-client/package-format"
}
