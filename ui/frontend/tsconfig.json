{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@bindings": ["./src/bindings/github.com/fosrl/windows/ui/index.ts"],
      "@bindings/*": ["./src/bindings/github.com/fosrl/windows/ui/*"]
    }
  },
  "include": ["src"]
}
